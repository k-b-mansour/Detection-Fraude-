POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=frauddetect
POSTGRES_USER=fraud_admin
POSTGRES_PASSWORD=fraud_secret

REDIS_HOST=localhost
REDIS_PORT=6380

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC=transactions.raw

# Suivi d'expériences MLflow (service `mlflow` du docker-compose, UI http://localhost:5001).
# Si le serveur est injoignable, les notebooks BC03/BC04 basculent sur un store fichier local mlruns/.
MLFLOW_TRACKING_URI=http://localhost:5001
# Registre de modèles interrogé par l'API BC05 (repli sur le .joblib versionné si vide/injoignable).
MLFLOW_MODELE=fraud_lightgbm
MLFLOW_MODELE_ALIAS=production
